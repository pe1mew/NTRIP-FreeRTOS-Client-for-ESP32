# Flash Size (WEMOS LOLIN S3 has 16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Log Level Configuration - Reduced to WARN for flash savings
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2

# Compiler Optimizations
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Disable Bluetooth (saves ~400KB)
CONFIG_BT_ENABLED=n

# Disable Core Dump (saves ~20-50KB)
CONFIG_ESP_COREDUMP_ENABLE=n

# Disable Console Features (saves ~10-20KB)
CONFIG_ESP_CONSOLE_USB_CDC=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Optimize Wi-Fi (disable unused features)
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n  # Cannot disable - needed for AP mode

# Disable unnecessary task watchdog verbosity
CONFIG_ESP_TASK_WDT_PANIC=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# mbedTLS: use common (not full) certificate bundle (~30-50KB savings)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# mbedTLS: disable SHA512 (only SHA256 is needed for most TLS) (~8KB savings)
CONFIG_MBEDTLS_SHA512_C=n

# mbedTLS: disable unused/rare ECC curves (~10-20KB savings)
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n

# Disable IPv6 if not used (~10-15KB savings)
# CONFIG_LWIP_IPV6=n  # Uncomment if IPv6 is not needed

# Link Time Optimization (~5-15KB savings)
CONFIG_COMPILER_CXX_EXCEPTIONS=n

# Minimize bootloader log output
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2
